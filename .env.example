# Copy to .env and fill in. .env is git-ignored; never put real values in this file.
# `docker compose up` reads .env automatically.

# --- LLM ---
AEOS_LLM_PROVIDER=gemini            # "fake" = scripted (tests/offline); "gemini" = live
AEOS_GEMINI_API_KEY=                # from https://aistudio.google.com/apikey

# --- real GitHub repo for "change request" tasks (optional) ---
# Token needs Contents + Pull requests: read/write on that one repository.
AEOS_GITHUB_REPO=                   # owner/name
AEOS_GITHUB_TOKEN=
AEOS_GITHUB_PUBLISH=true            # false = keep every PR local

# --- infrastructure endpoints (non-secret local defaults) ---
AEOS_DATABASE_URL=postgresql://aeos:aeos@localhost:5432/aeos
AEOS_READONLY_DATABASE_URL=postgresql://aeos_readonly:aeos_readonly@localhost:5432/aeos
AEOS_REDIS_URL=redis://localhost:6380/0
AEOS_OTEL_EXPORTER_ENDPOINT=http://localhost:4317
AEOS_LANGFUSE_HOST=http://localhost:3000
AEOS_GIT_REMOTE_PATH=demo_target/build/remote/checkout-service.git
AEOS_WEB_ALLOWED_HOSTS=localhost,127.0.0.1
AEOS_WEB_CORPUS_DIR=demo_target/web_corpus
AEOS_WEB_CORPUS_URL=http://127.0.0.1:8765
AEOS_LOG_LEVEL=INFO

# --- local Langfuse + service credentials: REQUIRED by docker-compose, choose your own ---
# Generate each with:  openssl rand -hex 24      (ENCRYPTION_KEY: openssl rand -hex 32)
AEOS_LANGFUSE_PUBLIC_KEY=           # e.g. pk-lf-<random>
AEOS_LANGFUSE_SECRET_KEY=           # e.g. sk-lf-<random>
LANGFUSE_BASIC_AUTH=                # base64("<public key>:<secret key>"):  printf '%s:%s' PUB SEC | base64 -w0
LANGFUSE_SALT=
LANGFUSE_ENCRYPTION_KEY=
LANGFUSE_NEXTAUTH_SECRET=
LANGFUSE_INIT_PASSWORD=             # password of the local Langfuse dev login
LANGFUSE_MINIO_PASSWORD=
LANGFUSE_REDIS_PASSWORD=
AEOS_A2A_API_KEY=                   # bearer token between the supervisor and A2A specialists
